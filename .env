# Server Configuration for Railway
PORT=8080
NODE_ENV=production

# Database Configuration - Railway will provide these via environment variables
# These are fallback values for local development
MYSQLHOST=mysql-odu5.railway.internal
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=your_database_password
MYSQLDATABASE=railway

# JWT Configuration
JWT_SECRET=my_jwt_secret_key_12345
JWT_EXPIRE=7d
UPLOAD_PATH=./uploads
FRONTEND_URL=https://funny-melba-61fb3d.netlify.app

# Railway specific variables
RAILWAY_DEPLOYMENT=true